{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
  "type": "Image",
  "url": "https://raw.githubusercontent.com/ludgerios/power-automate-compliance-notifications-/main/card-icons/ludgeriios-logo.png",
  "altText": "Ludgeriios Automações e Soluções",
  "size": "Stretch",
  "horizontalAlignment": "Center",
  "spacing": "None"
},
   {
      "type": "TextBlock",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "Accent",
      "text": "Lembrete de Controle de Compliance",
      "wrap": true,
      "horizontalAlignment": "Center"
    },
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "text": "Olá, @{item()?['ControlOwner']}!",
      "wrap": true,
      "separator": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Controle que requer atenção",
          "weight": "Bolder",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "@{outputs('Montar_Descrição_do_Controle')}",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {
          "title": "Dias até o teste:",
          "value": "@{outputs('Preparar_Quantidade_de_Dias')}"
        },
        {
          "title": "Status:",
          "value": "@{item()?['TestStatus']}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Revise as informações do controle e prepare as evidências necessárias antes da data programada para o teste.",
      "wrap": true,
      "spacing": "Medium",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Acessar o projeto",
      "url": "https://github.com/ludgerios/power-automate-compliance-notifications-"
    }
  ]
}
