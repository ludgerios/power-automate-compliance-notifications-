{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Image",
      "url": "https://raw.githubusercontent.com/ludgerios/power-automate-compliance-notifications-/main/card-icons/ludgeriios-logo.png",
      "altText": "Ludgeriios Automações e Soluções",
      "size": "Stretch",
      "horizontalAlignment": "Center",
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "color": "Accent",
      "text": "Lembrete de Controle de Compliance",
      "wrap": true,
      "horizontalAlignment": "Center",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "text": "Olá, @{item()?['ControlOwner']}!",
      "wrap": true,
      "separator": true,
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Controle que requer atenção",
          "weight": "Bolder",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "FactSet",
          "spacing": "Small",
          "facts": [
            {
              "title": "Nº do controle:",
              "value": "@{item()?['ControlID']}"
            },
            {
              "title": "Descrição:",
              "value": "@{item()?['ControlDescription']}"
            },
            {
              "title": "Data do próximo teste:",
              "value": "@{formatDateTime(addDays('1899-12-30',int(item()?['NextTestDate'])),'dd/MM/yyyy')}"
            },
            {
              "title": "Status:",
              "value": "@{item()?['TestStatus']}"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "warning",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "weight": "Bolder",
          "wrap": true,
          "text": "@{if(less(outputs('DiasParaVencer'),0),concat('Em atraso há ',string(mul(outputs('DiasParaVencer'),-1)),' dia(s).'),concat('Faltam ',string(outputs('DiasParaVencer')),' dia(s) para o teste.'))}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Revise as informações do controle e prepare as evidências necessárias para a execução do teste.",
      "wrap": true,
      "spacing": "Medium",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Acessar o projeto",
      "url": "https://github.com/ludgerios/power-automate-compliance-notifications-"
    }
  ]
}
